# PhoenixRPA environment configuration

APP_NAME=PhoenixRPA
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql://username:password@localhost:5432/phoenixrpa

PHOENIXRPA_EXTENSION_PATH=./extension

# LLM configuration
# Supported values: mock, openai
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
LLM_API_KEY=

LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT=30
